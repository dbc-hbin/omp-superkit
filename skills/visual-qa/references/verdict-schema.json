{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pass": {
      "enum": [
        "A",
        "B",
        "pixel-compare",
        "code-fidelity"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "REVISE",
        "FAIL"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "summary": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "pageIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "A7",
              "A8",
              "A9",
              "A10",
              "A11",
              "A13",
              "B1",
              "B2",
              "B3",
              "B4",
              "B5",
              "B6",
              "B8",
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8",
              "D1",
              "D2",
              "D3",
              "D4",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6",
              "F7",
              "F8",
              "F9",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7",
              "H8",
              "H9",
              "H10",
              "H11",
              "H12",
              "H13",
              "H14",
              "H15",
              "H16",
              "H17",
              "H18",
              "H19",
              "I1",
              "I2",
              "I3",
              "I4",
              "I5",
              "J1",
              "J2"
            ]
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNVERIFIED",
              "N/A"
            ]
          },
          "capture": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "gap": {
            "$ref": "#/definitions/verificationGap"
          },
          "behaviour": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/behaviourCase" }
          }
        },
        "required": [
          "id",
          "verdict",
          "capture",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "id": { "enum": ["H12", "H13", "H14", "H15", "H16", "H17", "H18", "H19"] },
                "verdict": { "enum": ["PASS", "FAIL", "UNVERIFIED"] }
              }
            },
            "then": {
              "required": ["behaviour"],
              "not": { "required": ["gap"] },
              "allOf": [
                {
                  "if": { "properties": { "verdict": { "const": "PASS" } } },
                  "then": { "properties": { "behaviour": { "items": { "properties": { "verdict": { "const": "PASS" } } } } } }
                },
                {
                  "if": { "properties": { "verdict": { "const": "FAIL" } } },
                  "then": { "properties": { "behaviour": { "contains": { "properties": { "verdict": { "const": "FAIL" } } } } } }
                },
                {
                  "if": { "properties": { "verdict": { "const": "UNVERIFIED" } } },
                  "then": {
                    "properties": {
                      "behaviour": {
                        "items": { "properties": { "verdict": { "enum": ["PASS", "UNVERIFIED"] } } },
                        "contains": { "properties": { "verdict": { "const": "UNVERIFIED" } } }
                      }
                    }
                  }
                }
              ]
            },
            "else": {
              "not": { "required": ["behaviour"] },
              "if": { "properties": { "verdict": { "const": "UNVERIFIED" } } },
              "then": { "required": ["gap"] },
              "else": { "not": { "required": ["gap"] } }
            }
          },
          {
            "if": { "properties": { "verdict": { "const": "N/A" } } },
            "then": { "properties": { "reason": { "minLength": 1 } } }
          }
        ]
      }
    },
    "evidenceTrace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "product",
              "evidence"
            ]
          },
          "dimension": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "dimension",
          "severity",
          "location",
          "problem",
          "fix",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "good": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "pass",
    "verdict",
    "confidence",
    "summary",
    "revision",
    "pageIds",
    "checklist",
    "evidenceTrace",
    "findings",
    "good",
    "blocking",
    "artifacts"
  ],
  "additionalProperties": false,
  "if": { "properties": { "verdict": { "const": "PASS" } } },
  "then": {
    "properties": {
      "checklist": { "$ref": "#/definitions/passingChecklist" },
      "blocking": { "maxItems": 0 }
    }
  },
  "definitions": {
    "passingChecklist": {
      "items": { "properties": { "verdict": { "enum": ["PASS", "N/A"] } } }
    },
    "verificationGap": {
      "type": "object",
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "resolution": { "enum": ["NEEDS WORK", "NEEDS HUMAN REVIEW"] }
      },
      "required": ["reason", "verifier", "resolution"],
      "additionalProperties": false
    },
    "behaviourCase": {
      "type": "object",
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "claim": { "enum": ["condition", "success"] },
        "verdict": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
        "execution": {
          "type": "object",
          "properties": {
            "basis": { "enum": ["real-path", "injected-condition", "stubbed-success"] },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["basis", "artifacts"],
          "additionalProperties": false
        },
        "traced": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "gap": { "$ref": "#/definitions/verificationGap" }
      },
      "required": ["scenario", "claim", "verdict"],
      "additionalProperties": false,
      "if": { "properties": { "verdict": { "const": "UNVERIFIED" } } },
      "then": { "required": ["gap"] },
      "else": {
        "required": ["execution"],
        "not": { "required": ["gap"] },
        "properties": {
          "execution": { "properties": { "basis": { "enum": ["real-path", "injected-condition"] } } }
        },
        "if": { "properties": { "claim": { "const": "success" }, "verdict": { "const": "PASS" } } },
        "then": { "properties": { "execution": { "properties": { "basis": { "const": "real-path" } } } } }
      }
    }
  }
}

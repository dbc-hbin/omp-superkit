{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "verdict": { "enum": ["GOOD", "NEEDS WORK", "NEEDS HUMAN REVIEW"] },
    "revision": { "type": "string" },
    "captureManifest": {
      "type": "string",
      "description": "Evidence manifest for the current build, including case actions, data/backend, captures, effects and readback as applicable."
    },
    "pageIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checklist": { "$ref": "verdict-schema.json#/properties/checklist" },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "enum": ["design-system", "features", "alpha", "reference-fidelity", "CJK", "pagination"] },
          "verdict": { "enum": ["PASS", "FAIL", "UNVERIFIED", "N/A"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": { "type": "string" },
          "gap": { "$ref": "verdict-schema.json#/definitions/verificationGap" }
        },
        "required": ["name", "verdict", "evidence", "reason"],
        "additionalProperties": false,
        "allOf": [{ "$ref": "verdict-schema.json#/definitions/captureGapByVerdict" }]
      }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "verdict-schema.json" }
    },
    "mustFix": { "$ref": "verdict-schema.json#/properties/findings" },
    "good": { "$ref": "verdict-schema.json#/properties/good" },
    "completionGate": {
      "type": "object",
      "properties": {
        "satisfied": { "type": "boolean" },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptedBy": { "type": "string" }
      },
      "required": ["satisfied", "gaps", "acceptedBy"],
      "additionalProperties": false
    },
    "prerequisites": {
      "type": "array",
      "description": "Outstanding external prerequisites, such as access to a required device or reviewer.",
      "items": { "type": "string", "minLength": 1 }
    },
    "pageVerdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pageId": { "type": "string" },
          "verdict": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
          "captures": {
            "type": "array",
            "items": { "type": "string" }
          },
          "gaps": {
            "type": "array",
            "items": { "$ref": "verdict-schema.json#/definitions/verificationGap" }
          }
        },
        "required": ["pageId", "verdict", "captures", "gaps"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "PASS" } } },
            "then": { "properties": { "gaps": { "maxItems": 0 } } }
          },
          {
            "if": { "properties": { "verdict": { "const": "UNVERIFIED" } } },
            "then": { "properties": { "gaps": { "minItems": 1 } } }
          }
        ]
      }
    }
  },
  "required": [
    "verdict",
    "revision",
    "captureManifest",
    "pageIds",
    "checklist",
    "dimensions",
    "reviews",
    "mustFix",
    "good",
    "completionGate",
    "prerequisites",
    "pageVerdicts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "GOOD" } } },
      "then": {
        "properties": {
          "checklist": { "$ref": "verdict-schema.json#/definitions/passingChecklist" },
          "dimensions": { "items": { "properties": { "verdict": { "enum": ["PASS", "N/A"] } } } },
          "reviews": { "items": { "properties": { "verdict": { "const": "PASS" } } } },
          "mustFix": { "maxItems": 0 },
          "prerequisites": { "maxItems": 0 },
          "completionGate": {
            "properties": { "satisfied": { "const": true }, "gaps": { "maxItems": 0 } }
          },
          "pageVerdicts": { "items": { "properties": { "verdict": { "const": "PASS" } } } }
        }
      },
      "else": { "properties": { "completionGate": { "properties": { "satisfied": { "const": false } } } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "NEEDS HUMAN REVIEW" } } },
      "then": {
        "anyOf": [
          { "properties": { "prerequisites": { "minItems": 1 } } },
          { "properties": { "checklist": { "$ref": "#/definitions/hasUnverified" } } },
          { "properties": { "dimensions": { "$ref": "#/definitions/hasUnverified" } } },
          { "properties": { "pageVerdicts": { "$ref": "#/definitions/hasUnverified" } } },
          {
            "properties": { "reviews": { "contains": { "anyOf": [
              { "properties": { "checklist": { "$ref": "#/definitions/hasUnverified" } } },
              { "properties": { "blocking": { "minItems": 1 } } }
            ] } } }
          }
        ],
        "properties": { "completionGate": { "properties": { "gaps": { "minItems": 1 } } } }
      }
    },
    {
      "if": { "$ref": "#/definitions/hasOpenWork" },
      "then": { "properties": { "verdict": { "const": "NEEDS WORK" } } },
      "else": { "properties": { "verdict": { "enum": ["GOOD", "NEEDS HUMAN REVIEW"] } } }
    }
  ],
  "definitions": {
    "hasUnverified": {
      "contains": { "properties": { "verdict": { "const": "UNVERIFIED" } } }
    },
    "actionableGap": {
      "properties": { "resolution": { "const": "NEEDS WORK" } },
      "required": ["resolution"]
    },
    "failedOrActionable": {
      "anyOf": [
        { "properties": { "verdict": { "const": "FAIL" } }, "required": ["verdict"] },
        { "properties": { "gap": { "$ref": "#/definitions/actionableGap" } }, "required": ["gap"] }
      ]
    },
    "checklistWithOpenWork": {
      "contains": {
        "anyOf": [
          { "$ref": "#/definitions/failedOrActionable" },
          {
            "required": ["behaviour"],
            "properties": { "behaviour": { "contains": { "$ref": "#/definitions/failedOrActionable" } } }
          }
        ]
      }
    },
    "hasOpenWork": {
      "anyOf": [
        { "properties": { "mustFix": { "minItems": 1 } } },
        { "properties": { "checklist": { "$ref": "#/definitions/checklistWithOpenWork" } } },
        {
          "properties": {
            "reviews": {
              "contains": {
                "anyOf": [
                  { "$ref": "#/definitions/failedOrActionable" },
                  { "properties": { "blocking": { "contains": { "$ref": "#/definitions/actionableGap" } } } },
                  { "properties": { "checklist": { "$ref": "#/definitions/checklistWithOpenWork" } } }
                ]
              }
            }
          }
        },
        { "properties": { "dimensions": { "contains": { "$ref": "#/definitions/failedOrActionable" } } } },
        {
          "properties": {
            "pageVerdicts": { "contains": { "anyOf": [
              { "properties": { "verdict": { "const": "FAIL" } } },
              { "properties": { "gaps": { "contains": { "$ref": "#/definitions/actionableGap" } } } }
            ] } }
          }
        }
      ]
    }
  }
}
